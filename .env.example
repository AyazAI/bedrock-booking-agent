# Copy to .env. The app runs with no keys when LLM_PROVIDER=mock.

LLM_PROVIDER=mock
# Comma-separated fallback, for example: bedrock,openai,mock
# A provider with an empty key is skipped before any network call.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AWS_REGION=us-east-1
# Confirm the id in the Bedrock console before turning this on. It spends money.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

DATABASE_URL=sqlite:///./data/bookings.db
VECTOR_BACKEND=chroma
CHROMA_PATH=./data/chroma
FAQ_SCORE_THRESHOLD=0.28

DEMO_API_KEY=demo
SEED_DEMO=true

# Off until a Meta app is configured. Empty secret rejects webhook posts.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
